<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Status</th>
            <th>Total</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (_orders != null)
        {
            @foreach (var order in _orders)
            {
                <tr>
                    <td>@order.Id.ToString().Substring(0, 8)...</td>
                    <td><span class="badge bg-primary">@order.Status</span></td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>@order.CreatedAt.ToShortTimeString()</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => CancelOrder(order.Id)">Cancel</button>
                        <button class="btn btn-sm btn-success" @onclick="() => CheckWaitTime(order.Id)">Wait Time</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => ViewDetails(order.Id)">Details</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5">Interesting... there seems to be nothing here! 🦗🦗🦗</td></tr>
        }
    </tbody>
</table>

@if (_waitTimeMessage != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @_waitTimeMessage
        <button type="button" class="btn-close" @onclick="() => _waitTimeMessage = null"></button>
    </div>
}
@code {
    private List<Models.Orders>? _orders;

    private UserSession _user;
    
    private string _searchQuery = "";
    private string? _waitTimeMessage;
    
    

    protected override async Task OnInitializedAsync()
    {
        var cookie = await JsRuntime.InvokeAsync<string>("eval", "document.cookie");
        if (!string.IsNullOrEmpty(cookie))
        {
            var token = AuthService.GetTokenAsync(cookie);

            try
            {
                _user = AuthService.ParseJwt(token);
                await LoadOrders();
            }
            catch
            {
                Navigation.NavigateTo("/login");
            }
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadOrders()
    {
        // Using a generic search/list endpoint or specifically GetAllOrders
        try
        {
            _orders = await OrderService.GetAllOrdersAsync(_user.Id);
        }
        catch (Exception ex)
        {
            _orders = null;
        }
    }

    private async Task SearchOrders()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
            {
                await LoadOrders();
            }
            else
            {
                _orders = await OrderService.SearchOrdersAsync(_searchQuery, "");
            }
        }
        catch (Exception ex)
        {
            _orders = null;
        }
    }

    private async Task CancelOrder(Guid id)
    {
        await OrderService.CancelOrderAsync(id);
        await LoadOrders();
    }

    private async Task CheckWaitTime(Guid id)
    {
        var time = await OrderService.GetOrderWaitTimeAsync(id);
        _waitTimeMessage = $"Estimated wait time for order {id.ToString().Substring(0,4)}: {time.EstimatedWaitMinutes} minutes";
    }
    
    
    private void ViewDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/orders/{id}");
    }
}