@page "/orders"
@using CampusEatsUI.Models.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input @bind="searchQuery" class="form-control" placeholder="Search orders..." />
            <button class="btn btn-outline-secondary" @onclick="SearchOrders">Search</button>
        </div>
    </div>
    <div class="col-md-6">
        <button class="btn btn-info" @onclick="GetStatistics">Load Statistics</button>
    </div>
</div>

@if (stats != null)
{
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Overall Stats</div>
                <div class="card-body">
                    <p class="card-text"><strong>Total Orders:</strong> @stats.TotalOrders</p>
                    <p class="card-text"><strong>Total Revenue:</strong> @stats.TotalRevenue.ToString("C")</p>
                    <p class="card-text"><strong>Avg. Order Value:</strong> @stats.AverageOrderValue.ToString("C")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Today's Stats</div>
                <div class="card-body">
                    <p class="card-text"><strong>Orders Today:</strong> @stats.TodayOrders</p>
                    <p class="card-text"><strong>Revenue Today:</strong> @stats.TodayRevenue.ToString("C")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Orders by Status</div>
                <div class="card-body">
                    @foreach (var status in stats.OrdersByStatus)
                    {
                        <p class="card-text mb-1"><strong>@status.Key:</strong> @status.Value</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>User</th>
            <th>Status</th>
            <th>Total</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (orders != null)
        {
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.Id.ToString().Substring(0, 8)...</td>
                    <td>@order.UserId</td>
                    <td><span class="badge bg-primary">@order.Status</span></td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>@order.CreatedAt.ToShortTimeString()</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => CancelOrder(order.Id)">Cancel</button>
                        <button class="btn btn-sm btn-success" @onclick="() => CheckWaitTime(order.Id)">Wait Time</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => ViewDetails(order.Id)">Details</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (waitTimeMessage != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @waitTimeMessage
        <button type="button" class="btn-close" @onclick="() => waitTimeMessage = null"></button>
    </div>
}
@code {
    private List<OrderDto>? orders;
    // Assuming the new DTO is in the same namespace
    // public record OrderStatisticsDTO(int TotalOrders, decimal TotalRevenue, decimal AverageOrderValue, Dictionary<string, int> OrdersByStatus, int TodayOrders, decimal TodayRevenue);
    private OrderStatisticsDTO? stats;
    private string searchQuery = "";
    private string? waitTimeMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        // Using a generic search/list endpoint or specifically GetAllOrders
        try
        {
            orders = await Http.GetFromJsonAsync<List<OrderDto>>($"http://localhost:5168/orders");
        }
        catch (Exception ex)
        {
            // Optionally log the exception
            // For now, we fail silently to prevent UI crash
        }
    }

    private async Task SearchOrders()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                await LoadOrders();
            }
            else
            {
                orders = await Http.GetFromJsonAsync<List<OrderDto>>($"http://localhost:5168/orders/search?query={searchQuery}");
            }
        }
        catch (Exception ex)
        {
            // Log or handle error
        }
    }

    private async Task CancelOrder(Guid id)
    {
        await Http.PutAsync($"http://localhost:5168/orders/{id}/cancel", null);
        await LoadOrders();
    }

    private async Task CheckWaitTime(Guid id)
    {
        var time = await Http.GetFromJsonAsync<OrderWaitTimeResponse>($"http://localhost:5168/orders/{id}/wait-time");
        waitTimeMessage = $"Estimated wait time for order {id.ToString().Substring(0,4)}: {time.EstimatedWaitMinutes} minutes";
    }

    private async Task GetStatistics()
    {
        stats = await Http.GetFromJsonAsync<OrderStatisticsDTO>($"http://localhost:5168/orders/statistics");
    }
    
    private void ViewDetails(Guid id)
    {
        //redirect to localhost/orders/{OrderId:guid}
        NavigationManager.NavigateTo($"/orders/{id}");
        
    }
}