@page "/"
@using MudBlazor

<PageTitle>CampusEats - Dashboard</PageTitle>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudText Typo="Typo.h4" GutterBottom="true">Welcome to CampusEats!</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">Order your favorite meals from campus cafeteria</MudText>
        
        <!-- Quick Stats -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="pa-4">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Active Orders</MudText>
                    <MudText Typo="Typo.h4">2</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="pa-4">
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Loyalty Points</MudText>
                    <MudText Typo="Typo.h4">150</MudText>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
    
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">Today's Special</MudText>
                <MudImage Src="/images/special-dish.jpg" Height="200" />
                <MudText Typo="Typo.body2" Class="mt-2">Chef's Special Pasta - $8.99</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>