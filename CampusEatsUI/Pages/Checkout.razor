@page "/checkout"
@using CampusEatsUI.Models
@using CampusEatsUI.Models.Helpers
@using CampusEatsUI.Services.Helpers
@using CampusEatsUI.Services.Menu
@using CampusEatsUI.Services.Orders
@using CampusEatsUI.Services.Payment
@using CampusEatsUI.Services.UserLoyalty
@inject IOrderService OrderService
@inject CartState CartState
@inject IMenuService MenuService;
@inject IPaymentService PaymentService;
@inject NavigationManager NavigationManager;
@inject IUserLoyaltyService UserLoyaltyService;

<h3>Order Details</h3>

@if (CartState.CartItems != null && CartState.CartItems.Any())
{
    <div class="card mt-3">
        <div class="card-header">
            Summary for User ID: @CartState.UserId
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var cartItem in CartState.CartItems)
            {
                var menuItem = _menuItems.FirstOrDefault(m => m.Id == cartItem.MenuItemId);
                if (menuItem != null)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @menuItem.Name
                        <span>@menuItem.Price.ToString("C") x @cartItem.Quantity</span>
                    </li>
                }
            }
            @if (_loyalties?.Points > 0)
            {
                <li class="list-group-item">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="useLoyaltyPoints" @bind="_useLoyaltyPoints">
                        <label class="form-check-label" for="useLoyaltyPoints">
                            Use Loyalty Points (25% Discount)
                        </label>
                    </div>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between">
                <strong>Total</strong>
                <strong>@GetTotal().ToString("C")</strong>
            </li>
        </ul>
    </div>
    <button class="btn btn-success mt-3" @onclick="Pay">Pay</button>
}

@code {
    private List<MenuItem> _menuItems = new();
    private UserPoints _loyalties;
    private bool _useLoyaltyPoints;

    protected override async Task OnInitializedAsync()
    {
        _menuItems = await MenuService.GetAllMenuItemsAsync();
        _loyalties = await UserLoyaltyService.GetUserLoyaltyPointsAsync(CartState.UserId);
    }

    private decimal GetTotal()
    {
        var total = CartState.CartItems.Sum(c => (_menuItems.FirstOrDefault(m => m.Id == c.MenuItemId)?.Price ?? 0) * c.Quantity);
        return _useLoyaltyPoints ? total * 0.75m : total;
    }

    private async Task Pay()
    {
        var order = await OrderService.CreateOrderAsync(CartState.UserId, CartState.CartItems, "Generated by the UI");
        var orderId = order.Id;
        var response = await PaymentService.CreateCheckoutSessionAsync(orderId, CartState.UserId, null, null);
        NavigationManager.NavigateTo(response.CheckoutUrl);
    }

}