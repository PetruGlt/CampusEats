@page "/loyalty"
@using CampusEatsUI.Models.Helpers
@using CampusEatsUI.Services.Auth
@using CampusEatsUI.Services.UserLoyalty
@inject NavigationManager NavigationManager
@inject IUserLoyaltyService UserLoyaltyService
@inject IAuthService AuthService;
@inject IJSRuntime JsRuntime;

<h3>Loyalty Program</h3>

<div class="card text-center w-50 mx-auto mt-5">
    <div class="card-body">
        @if (points == null)
        {
            <p>Loading...</p>
        }
        else if (points.Points != 0)
        {
            <div class="mt-4">
                <h5>You have @points.Points 😃</h5>
                <p>Use your loyalty points to get 25% discount</p>
            </div>
        }
        else
        {
            <div class="mt-4">
                <h5>You have no points ☹️</h5>
            </div>
        }
        
        <button class="btn btn-primary mt-4" @onclick="RedirectToMenu">Menu</button>
    </div>
</div>
@code {
    private UserSession _user;
    private UserPoints points;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cookie = await JsRuntime.InvokeAsync<string>("eval", "document.cookie");
            if (!string.IsNullOrEmpty(cookie))
            {
                var token = AuthService.GetTokenAsync(cookie);
                if (!string.IsNullOrEmpty(token))
                {
                    _user = AuthService.ParseJwt(token);
                    points = await UserLoyaltyService.GetUserLoyaltyPointsAsync(_user.Id);
                    Console.WriteLine(points);
                }
                else
                {
                    NavigationManager.NavigateTo("/login");
                }
            }
            else
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loyalty points: {ex.Message}");
        }
    }
    
    private void RedirectToMenu()
    {
        NavigationManager.NavigateTo("/menu");
    }
}