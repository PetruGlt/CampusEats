@page "/orders/{OrderId:guid}"
@using CampusEatsUI.Services.Orders
@inject NavigationManager NavigationManager
@inject IOrderService OrderService;

<h3>Order Details</h3>

@if (order == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-header">
            Order #@order.Id.ToString().Substring(0, 8)
        </div>
        <div class="card-body">
            <h5 class="card-title">Order Summary</h5>
            <p class="card-text"><strong>Status:</strong> @order.Status</p>
            <p class="card-text"><strong>Total:</strong> @order.TotalAmount.ToString("C")</p>
            <p class="card-text"><strong>Date:</strong> @order.CreatedAt.ToLocalTime()</p>

            <h6>Items:</h6>
            <ul class="list-group list-group-flush">
                @foreach (var item in order.Items)
                {
                    <li class="list-group-item">@item.MenuItemName - @item.Quantity x @item.Price.ToString("C")</li>
                }
            </ul>
        </div>
        <div class="card-footer">
            @if (order.Status == "Pending")
            {
                <button class="btn btn-success" @onclick="Checkout" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Processing...</span>
                    }
                    else
                    {
                        <span>Proceed to Orders</span>
                    }
                </button>
            }
            else
            {
                <p>This order has been processed.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid OrderId { get; set; }
    private Models.Orders order;
    private bool isProcessing = false;
    private bool useLoyaltyPoints = false;

    protected override async Task OnInitializedAsync()
    {
        order = await OrderService.GetOrderByIdAsync(OrderId);
    }

    private async Task Checkout()
    {
        NavigationManager.NavigateTo($"/orders");
    }
}