@page "/admin/Payment"
@using CampusEatsUI.Models
@using CampusEatsUI.Models.Helpers
@using CampusEatsUI.Services.Payment
@inject HttpClient Http
@inject IPaymentService PaymentService

<h3>Payments</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <label>User ID Filter:</label>
        <div class="input-group">
            <input @bind="userId" class="form-control" placeholder="User ID" />
            <button class="btn btn-primary" @onclick="LoadPayments">Filter</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <h4>Payment History</h4>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Order ID</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @if (payments != null)
            {
                @foreach (var p in payments)
                {
                    <tr>
                        <td>@p.PaymentId.ToString().Substring(0, 6)...</td>
                        <td>@p.OrderId.ToString().Substring(0, 6)...</td>
                        <td>@p.Amount.ToString("C")</td>
                        <td>
                            <span class="@GetStatusBadge(p.Status)">@p.Status</span>
                        </td>
                        <td>@p.CreatedAt.ToShortDateString()</td>
                        <td>
                            @if (p.Status != "Succeeded")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => CompletePayment(p.PaymentId)">Simulate Pay</button>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Create Checkout (Sim)</h5>
            <div class="mb-2">
                <label>Order ID:</label>
                <input @bind="newOrderId" class="form-control" placeholder="Guid..." />
            </div>
            <div class="mb-2">
                <label>Amount:</label>
                <input @bind="newAmount" type="number" class="form-control" />
            </div>
            <button class="btn btn-primary w-100" @onclick="CreateCheckout">Create Payment</button>
        </div>
    </div>
</div>


@code {
    private List<PaymentHistoryResponse> payments;
    private Guid userId = Guid.Empty;
    
    // Create Payment
    private string newOrderId = "";
    private decimal newAmount;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        try
        {
            payments = PaymentService.GetPaymentHistoryAsync(userId.ToString(), DateTime.MinValue, DateTime.MaxValue, string.Empty).Result.ToList();
        }
        catch
        {
            payments = new List<PaymentHistoryResponse>();
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Succeeded" => "badge bg-success",
        "Pending" => "badge bg-warning",
        "Failed" => "badge bg-danger",
        _ => "badge bg-secondary"
    };

    private async Task CreateCheckout()
    {
        if (Guid.TryParse(newOrderId, out Guid orderGuid))
        {
            /*var req = new CreatePaymentRequest(orderGuid, newAmount);
            await Http.PostAsJsonAsync("http://localhost:5168/payments/create-checkout", req);*/
            PaymentService.CreateCheckoutSessionAsync(Guid.NewGuid(), userId, null, null);
            
            await LoadPayments();
            newOrderId = "";
            newAmount = 0;
        }
    }

    private async Task CompletePayment(Guid paymentId)
    {
        await Http.PostAsync($"http://localhost:5168/payments/{paymentId}/test-complete", null);
        await LoadPayments();
    }
}