@page "/menu"
@using CampusEatsUI.Models
@using CampusEatsUI.Models.Helpers
@using CampusEatsUI.Services.Auth
@using CampusEatsUI.Services.Helpers
@using CampusEatsUI.Services.Menu
@using CampusEatsUI.Services.Orders
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject IMenuService MenuService;
@inject IOrderService OrderServices;
@inject IAuthenticationService AuthenticationService;
@inject CartState CartState;
<h3>Today's Specialty</h3>

<div class="row">
    <div class="col-md-8">
        <h4>Current Menu</h4>

        <div class="menu-grid">
            @if (_menuItems is not null)
            {
                @foreach (var item in _menuItems)
                {
                    <article class="menu-item card mb-2">
                        <div class="card-body">
                            <h4>@item.Name</h4>
                            <p>@item.Price.ToString("C")</p>
                            <button class="btn btn-primary" @onclick="() => AddToCart(item)">Add to Cart</button>
                        </div>
                    </article>
                }    
            }
            else
            {
                <p>Loading...</p>
            }
        </div>
    </div>

    <div class="col-md-4">
        <h4>Your Cart</h4>
        @if (_cart.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var cartItem in _cart)
                {
                    var menuItem = _menuItems.FirstOrDefault(m => m.Id == cartItem.MenuItemId);
                    if (menuItem == null) continue;
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">@menuItem.Name</h6>
                            <small class="text-muted">Quantity: @cartItem.Quantity</small>
                        </div>
                        <span class="text-muted">@menuItem.Price.ToString("C")</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span>Total (USD)</span>
                    <strong>@_cart.Sum(c => _menuItems.FirstOrDefault(m => m.Id == c.MenuItemId)?.Price ?? 0).ToString("C")</strong>
                </li>
            </ul>
            <button class="btn btn-success w-100" @onclick="GoToCheckout">Go to Checkout</button>
        }
        else
        {
            <p>Your cart is empty.</p>
        }
    </div>
</div>

@code {
    private List<MenuItem> _menuItems = new();
    private List<OrderItem> _cart = new();

    private UserSession _user;

    protected override async Task OnInitializedAsync()
    {
        var cookie = await JsRuntime.InvokeAsync<string>("eval", "document.cookie");
        if (!string.IsNullOrEmpty(cookie))
        {
            var token = AuthenticationService.GetTokenAsync(cookie);

            try
            {
                _user = AuthenticationService.ParseJwt(token);
                await GetMenuItemsAsync();
            }
            catch
            {
                Navigation.NavigateTo("/login");
            }
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
        
        
    }

    private async Task GetMenuItemsAsync()
    {
        try
        {
            _menuItems = await MenuService.GetAllMenuItemsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void AddToCart(MenuItem item)
    {
        _cart.Add(new OrderItem(
            item.Id,
            1,
            "Generated via the UI"
            ));
    }

    private void GoToCheckout()
    {
        CartState.UserId = _user.Id;
        CartState.CartItems = _cart;
        Navigation.NavigateTo("/checkout");
    }
}