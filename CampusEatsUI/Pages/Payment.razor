<div class="row">
    <div class="col-md-8">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Order ID</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
            </thead>
            <tbody>
            @if (_payments != null)
            {
                @foreach (var p in _payments)
                {
                    <tr>
                        <td>@p.PaymentId.ToString().Substring(0, 6)...</td>
                        <td>@p.OrderId.ToString().Substring(0, 6)...</td>
                        <td>@p.Amount.ToString("C")</td>
                        <td>
                            <span class="@GetStatusBadge(p.Status)">@p.Status</span>
                        </td>
                        <td>@p.CreatedAt.ToShortDateString()</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>


@code {
    private List<PaymentHistoryResponse> _payments;

    private UserSession _user;
    
    // Create Payment
    private string newOrderId = "";
    private decimal newAmount;

    protected override async Task OnInitializedAsync()
    {
        var cookie = await JsRuntime.InvokeAsync<string>("eval", "document.cookie");
        if (!string.IsNullOrEmpty(cookie))
        {
            var token = AuthenticationService.GetTokenAsync(cookie);

            try
            {
                _user = AuthenticationService.ParseJwt(token);
                await LoadPayments();
            }
            catch
            {
                Navigation.NavigateTo("/login");
            }
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadPayments()
    {
        try
        {
            _payments = await PaymentService.GetPaymentHistoryAsync(_user.Id.ToString(), DateTime.MinValue, DateTime.MaxValue, string.Empty);
        }
        catch
        {
            _payments = new List<PaymentHistoryResponse>();
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Succeeded" => "badge bg-success",
        "Pending" => "badge bg-warning",
        "Failed" => "badge bg-danger",
        _ => "badge bg-secondary"
    };
    
}