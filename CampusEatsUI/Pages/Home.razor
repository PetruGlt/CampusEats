@page "/"
@using CampusEatsUI.Models.Helpers
@using CampusEatsUI.Services.Auth
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IAuthenticationService AuthenticationService;

<h3>CampusEats.net</h3>
<p>Enjoy our thoughtfully crafted slop</p>

@if (_user != null)
{
    <div>
        <h5>Welcome back @_user.Username</h5>
        <p>Enjoy your stay</p>
        <button class="btn btn-danger mt-3" @onclick="Logout">Logout</button>
    </div>
}
else
{
    <a href="login" class="btn btn-primary">Login</a>
    <a href="register" class="btn btn-primary">Register</a>
}

@code {
    private UserSession? _user;

    protected override async Task OnInitializedAsync()
    {
        var cookie = await JsRuntime.InvokeAsync<string>("eval", "document.cookie");
        if (!string.IsNullOrEmpty(cookie))
        {
            var token = AuthenticationService.GetTokenAsync(cookie);

            try
            {
                _user = AuthenticationService.ParseJwt(token);
            }
            catch
            {
                _user = null;
            }
        }
    }

    private async Task Logout()
    {
        await AuthenticationService.LogoutAsync();
        _user = null;
        NavigationManager.Refresh();
    }
}