@using MudBlazor
@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <MudText Typo="Typo.h6">CampusEats</MudText>
        <MudSpacer />
        <MudIconButton Icon="Icons.Material.Filled.ShoppingCart" Color="Color.Inherit" />
        <MudMenu Icon="Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Label="Account">
            <MudMenuItem Icon="Icons.Material.Filled.Person">Profile</MudMenuItem>
            <MudMenuItem Icon="Icons.Material.Filled.ExitToApp">Logout</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}